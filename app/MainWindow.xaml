<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MidiMAT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MidiMAT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="MidiMAT"
    mc:Ignorable="d">

    <!--
      The shell is intentionally minimal: a single WebView2 filling the window.
      ALL navigation and chrome live in the React app (its own left sidebar), per the
      approved UI design. The native layer owns only the window, tray, and services.
    -->
    <Grid>
        <WebView2 x:Name="WebView" />

        <!--
          Tray icon. Draws nothing itself; its job is to keep MidiMAT reachable after
          the window is closed, because the sidecar has to stay alive for the OBS
          Browser Source to keep working. The image is assigned in code-behind from
          Assets\MidiMAT.ico (a string IconSource would resolve against ms-appx, which
          an unpackaged app does not have).
        -->
        <tb:TaskbarIcon x:Name="Tray" ToolTipText="MidiMAT">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Show MidiMAT" Click="TrayShow_Click" />
                    <MenuFlyoutItem Text="Open overlay in browser" Click="TrayOverlay_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit MidiMAT" Click="TrayQuit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
