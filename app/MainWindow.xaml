<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MidiMAT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MidiMAT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MidiMAT"
    mc:Ignorable="d">

    <!--
      The shell is intentionally minimal: a single WebView2 filling the window.
      ALL navigation and chrome live in the React app (its own left sidebar), per the
      approved UI design. The native layer owns only the window, tray, and services.
    -->
    <Grid>
        <WebView2 x:Name="WebView" />
    </Grid>
</Window>
